# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=elite_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elite_db

# Backend Configuration
ENVIRONMENT=development
API_LOG_LEVEL=info
SECRET_KEY=change-this-in-production-secret-key
API_V1_STR=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
IMPORT_MAX_FILE_SIZE_MB=10
IMPORT_DEFAULT_LOCALE=es_AR
IMPORT_DEFAULT_CURRENCY=ARS
IMPORT_STORAGE_DIR=/tmp/elite-imports

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
